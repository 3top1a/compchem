#!/usr/bin/env bash

set -e

base_directory="$(dirname "$0")"
export base_directory="$(readlink -f "$base_directory")"

export venv_directory="$base_directory/.venv"

echo "base_directory: $base_directory"

# This script runs the NRP repository tools

# Environment variables
# PYTHON:
#              python executable to use for running the NRP tools


# If there is a local environment file, source it. This is necessary on Mac OS X
# to set the correct environment variables for the python executable.
# An example file on mac os x is:
#
# ❯ cat ~/.envrc.local
#
# # dynamic libraries (such as cairo)
# export DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
#
if [ -f ~/.envrc.local ] ; then
  source ~/.envrc.local
fi

check_create_venv() {
  echo "Running uv sync..."
  # Unset PYTHONPATH to avoid nix-store packages polluting the venv
  unset PYTHONPATH
  uv sync
}

# Run uv sync first without activation
check_create_venv

# Unset PYTHONPATH before activation to avoid nix-store packages
unset PYTHONPATH
# Set LD_LIBRARY_PATH from NIX_LDFLAGS to find system libraries (cairo, etc.)
export LD_LIBRARY_PATH=$(echo "$NIX_LDFLAGS" 2>/dev/null | sed 's/-L/ /g' | xargs | sed 's/ /:/g' || echo "")
source "$venv_directory"/bin/activate

setup_frontend() {
  echo "Setting up frontend..."
  # Unset PYTHONPATH to avoid nix-store packages
  unset PYTHONPATH
  source "$venv_directory"/bin/activate

  # Convert paths to absolute paths
  absolute_venv="$(readlink -f "$venv_directory")"
  absolute_base="$(readlink -f "$base_directory")"

  # Create the instance directories
  mkdir -p "$absolute_venv/var/instance/assets"
  mkdir -p "$absolute_venv/var/instance/static"

  # Copy assets from ui to instance
  echo "Copying assets from ui to instance..."
  cp -r "$absolute_base/ui/static" "$absolute_venv/var/instance/" 2>/dev/null || true
  cp -r "$absolute_base/ui" "$absolute_venv/var/instance/assets/" 2>/dev/null || true

  # Install npm packages with --legacy-peer-deps to handle peer dependency conflicts
  echo "Installing npm packages..."
  cd "$absolute_venv/var/instance/assets"
  npm install --legacy-peer-deps 2>/dev/null || true

  echo "Frontend setup complete!"
}

run_service() {
  service_name=$1
  shift

  cmd=$1
  shift

  echo "Checking if should run $service_name ..."

  while [ -f $venv_directory/.run_${service_name} ] ; do
    echo "Trying to run $service_name ..."
    # Unset PYTHONPATH in the subshell to avoid nix-store packages
    PYTHONPATH="" "$cmd" "$@" </dev/null &
    pid=$!
    echo "Running $service_name with pid $pid ..."
    echo "$pid" > $venv_directory/.${service_name}_pid
    # wait up a bit if the process dies immediately
    sleep 10
    # wait for the process to finish
    while kill -0 "$pid" 2>/dev/null; do
      sleep 1
    done
  done
}

run_backend() {
  touch "$venv_directory/.run_backend"
  run_service backend \
    "$venv_directory"/bin/invenio run \
    --cert $base_directory/docker/development.crt \
    --key $base_directory/docker/development.key </dev/null
}

run_frontend() {
  touch "$venv_directory/.run_frontend"
  # The frontend source is in var/instance/assets (created by setup_frontend)
  absolute_venv="$(readlink -f "$venv_directory")"
  if [ -d "$absolute_venv/var/instance/assets" ] && [ -f "$absolute_venv/var/instance/assets/package.json" ]; then
    cd "$absolute_venv/var/instance/assets"
  else
    echo "Frontend not set up. Run 'nrp setup-frontend' first."
    return 1
  fi
  run_service frontend npm run start
}

stop_gracefully() {
  # check if process $1 exists and kill it
  if [ ! -f $1 ] ; then
    return
  fi
  pid=$(cat "$1")

  if kill -0 "$pid" 2>/dev/null; then
    kill $pid || true
  fi

  sleep 1

  if kill -0 "$pid" 2>/dev/null; then
    sleep 5
  fi

  if kill -0 "$pid" 2>/dev/null; then
    kill -9 $pid || true
  fi

  rm -f "$1" || true
}

stop_backend() {
  stop_gracefully "$venv_directory/.backend_pid"
}

stop_frontend() {
  stop_gracefully "$venv_directory/.frontend_pid"
}

develop_cleanup() {
  rm -f "$venv_directory/.run_backend"
  rm -f "$venv_directory/.run_frontend"

  echo "Stopping backend ..."
  stop_backend
  echo "Stopping frontend ..."
  stop_frontend

  exit 1
}


run_user_develop_input() {
  while true ; do
    echo
    echo "1 or server     - restart python server"
    echo "2 or ui         - restart webpack server"
    echo "0 or stop       - stop the server (Ctrl-C also works)"
    echo
    if read -t 30 -p "Enter command: " cmd ; then
      echo
      echo "Executing: $cmd"
      if [ "$cmd" == "stop" -o "$cmd" == "0" ] ; then
        break
      fi
      if [ "$cmd" == "server" -o "$cmd" == "1" ] ; then
        stop_backend
      elif [ "$cmd" == "frontend" -o "$cmd" == "2" ] ; then
        stop_frontend
      fi
    fi
  done
}

run_develop_with_shell() {
  # check if there is a develop --shell commands anywhere in arguments
  develop_called=0

  # Loop through all arguments
  for arg in "$@"; do
    if [[ "$arg" == "develop" ]]; then
      develop_called=1
    elif [[ "$arg" == "--shell" ]]; then
      return 0
    fi
  done
  return 1
}

# main entrypoint in here

# If no command specified, show help
if [ $# -eq 0 ]; then
  echo "Usage: $0 <command>"
  echo "Commands:"
  echo "  check            - Check prerequisites and repository readiness"
  echo "  setup-frontend   - Set up frontend assets and npm packages"
  echo "  develop --shell  - Start development server with services"
  echo "  invenio <cmd>    - Run invenio command"
  echo "  npm <cmd>        - Run npm command in ui directory"
  exit 1
fi

# Handle check command
if [ "$1" == "check" ]; then
  shift
  echo "Checking repository..."
  # Check Python version
  echo "Python version:"
  python --version 2>&1
  # Check if venv exists
  if [ -d "$venv_directory" ]; then
    echo "Virtual environment exists at $venv_directory"
  else
    echo "Virtual environment not found at $venv_directory"
  fi
  exit 0
fi

# Handle setup-frontend command
if [ "$1" == "setup-frontend" ]; then
  shift
  setup_frontend
  exit 0
fi

# Handle commands directly without nrp-devtools
case "$1" in
  develop)
    shift
    if [ "$1" == "--shell" ]; then
      shift
      # Run the command passed to develop
      if [ $# -gt 0 ]; then
        "$@"
      fi
    fi
    # Setup frontend first
    setup_frontend
    # Start services in background and run input loop
    trap develop_cleanup EXIT
    trap develop_cleanup SIGINT

    run_backend &
    sleep 2
    run_frontend &
    sleep 20
    run_user_develop_input
    ;;
  invenio)
    shift
    invenio "$@"
    ;;
  npm)
    shift
    cd "$(readlink -f "$venv_directory/var/instance/assets")" && npm "$@"
    ;;
  *)
    # Run any other command directly
    "$@"
    ;;
esac

# if running nrp develop in shell,
# start the services and run the input cmd watcher
if run_develop_with_shell "$@" ; then
  # Services already started above
  run_user_develop_input
fi
